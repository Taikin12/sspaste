{
	"schemaVersion": 1,
	"id": "picpaste",
	"version": "${version}",
	"name": "PicPaste",
	"description": "Paste images into Minecraft chat: upload them and insert the URL. Also previews image links in chat.",
	"authors": [
		"Taikin"
	],
	"license": "CC0-1.0",
	"icon": "assets/picpaste/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.picpaste.client.PicPasteClient"
		],
		"modmenu": [
			"com.picpaste.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "picpaste.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": ">=26.3.159"
	}
}
