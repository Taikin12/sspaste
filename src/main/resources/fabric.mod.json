{
	"schemaVersion": 1,
	"id": "ssclip",
	"version": "${version}",
	"name": "SSclip",
	"description": "SSclip: paste screenshots/images into Minecraft chat, upload them, and preview image links.",
	"authors": [
		"Taikin"
	],
	"license": "CC0-1.0",
	"icon": "assets/ssclip/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.ssclip.client.SSClipClient"
		],
		"modmenu": [
			"com.ssclip.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "ssclip.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": ">=26.3.159"
	}
}
