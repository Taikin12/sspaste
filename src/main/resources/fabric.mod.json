{
	"schemaVersion": 1,
	"id": "sspaste",
	"version": "${version}",
	"name": "SS Paste",
	"description": "SS Paste: paste screenshots/images into Minecraft chat, upload them, and preview image links.",
	"authors": [
		"Taikin"
	],
	"license": "CC0-1.0",
	"icon": "assets/sspaste/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.sspaste.client.SSPasteClient"
		],
		"modmenu": [
			"com.sspaste.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "sspaste.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": ">=26.3.159"
	}
}
